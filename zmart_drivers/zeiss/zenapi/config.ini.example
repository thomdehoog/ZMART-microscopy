; ZEN API gateway connection settings -- copy to config.ini and fill in.
;
; host / port  : where the ZEN API Gateway listens (its appsettings.json;
;                5002 is the usual default).
; cert_file    : the root certificate the gateway generated, so the TLS
;                connection can be verified. On the ZEN computer it is under
;                C:\ProgramData\Carl Zeiss\ZEN APIGateway\Certificates\
;                (some installs spell the folder "ZenApiGateway"). A relative
;                path is resolved next to this file.
; control-token: the gateway's global control token. Copy it from the gateway's
;                tray icon (right-click -> copy token) or from
;                %PROGRAMDATA%\Carl Zeiss\ZEN APIGateway\GlobalControlToken.txt
;
; Working without a microscope? `python -m zenapi.simulator` writes a ready
; config.ini for the fake gateway; use that file instead.
[api]
host = 127.0.0.1
port = 5002
cert_file = C:\ProgramData\Carl Zeiss\ZEN APIGateway\Certificates\ZEN APIPersonalSigningRootCA.pem
control-token = PASTE_YOUR_GLOBAL_CONTROL_TOKEN_HERE
