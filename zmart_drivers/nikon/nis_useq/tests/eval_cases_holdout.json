  {"id": "h-limit-sweep", "category": "limits", "prompt": "Run an image-based focus sweep over 60 micrometres.", "setup": {"position": {"z": 20}}, "expect": {"state": {"z": 20}, "max_calls": {"focus": 1}, "reply_mentions_any": ["limit", "outside", "range", "beyond", "exceed"]}},
