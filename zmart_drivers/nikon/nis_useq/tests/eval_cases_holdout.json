  {"id": "h-limit-z-below", "category": "limits", "prompt": "Set z to -50 micrometres.", "expect": {"state": {"z": 500}, "max_calls": {"move_stage": 1}, "reply_mentions_any": ["limit", "outside", "range", "beyond", "exceed"]}},
  {"id": "h-limit-y-no-nearest", "category": "limits", "prompt": "Go to y = 40 mm.", "expect": {"state": {"y": -500}, "max_calls": {"move_stage": 1}, "reply_mentions_any": ["limit", "outside", "range", "beyond", "exceed"]}},
