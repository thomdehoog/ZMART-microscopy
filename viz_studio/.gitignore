# Node dependencies and the built page are generated, not source.
frontend/node_modules/
frontend/dist/
sandwich/page/node_modules/
sandwich/page/dist/

# What `sandwich/measure.py` writes: the little acquisitions it makes for
# itself, and the results of one run. The photographs worth keeping are copied
# into sandwich/photographs/ by hand and are in the repository.
sandwich/results/

# The demo volume is generated on first run.
backend/demo_store/

# The store run_live_run_demo.py declares and fills; rebuilt on every run.
backend/live_run_demo/

# Python and test scratch.
**/__pycache__/
backend/_check/

# What measure_cold_open.py writes out for comparing two runs.
cold_open_*.json
