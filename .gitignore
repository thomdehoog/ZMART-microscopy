# Node's own workings. The JS project lives in `application/` and ignores
# these itself; this catches the copy that appears at the top of the tree
# when a node tool is run from here rather than from in there.
node_modules/
.vite/

__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.eggs/
dist/
build/
Thumbs.db
.DS_Store
*.zip
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
**/.claude/settings.local.json

# CI / test reports (regenerated by run_ci.py).
zmart_drivers/leica/stellaris5_y42h93/navigator_expert/tests/_report/

# Per-machine website launch settings (each microscope PC writes its own;
# see workflows/target_acquisition/start_website.bat for the format).
workflows/target_acquisition/start_website.local.bat

# Runtime outputs regenerated by notebooks and workflow runs.
zmart_drivers/leica/stellaris5_y42h93/navigator_expert/tests/hardware/*.jsonl
hardware_run_report_*.md
driver_log_*.log
zmart_drivers/leica/stellaris5_y42h93/navigator_expert/limits/current.json
workflows/target_acquisition/*_worked*.ipynb

# What `run_webapp.py --demo` writes: images, reports and the run journal of a
# simulated run. Regenerated on every demo, never part of the repository.
workflows/target_acquisition/zmart_demo_run/

# Where a background agent puts its own checkout of this repository while it
# works on a branch of its own. It is a copy of the project, not part of it, and
# it disappears when the agent finishes.
.claude/worktrees/

# The built operator page, beside the window that shows it. Generated by
# `npm run build` and served by the bridge; whether
# it ships in the repo is decided when the page is wired to the Python server —
# the microscope PC has no toolchain, so it will likely have to.
application/framework/window/static/

# Acquisitions, and the small files a writer leaves beside one. These are
# *data* — a run of two thousand positions is over a gigabyte — and git never
# forgets, so a store committed by accident is paid for by every clone from
# then on. Nothing here needs keeping: the measurement scripts write their
# stores from a seed, so any of them can be made again exactly.
*.ome.zarr/
*.writing
*-positions-arriving.jsonl
zmart-coverage/
mock-output/
application/mock-output/
