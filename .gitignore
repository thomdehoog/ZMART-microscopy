# CI / test reports (regenerated by run_ci.py).
zmart_drivers/leica/stellaris5_y42h93/navigator_expert/tests/_report/

# Runtime outputs regenerated by notebooks and workflow runs.
zmart_drivers/leica/stellaris5_y42h93/navigator_expert/tests/hardware/*.jsonl
hardware_run_report_*.md
driver_log_*.log
zmart_drivers/leica/stellaris5_y42h93/navigator_expert/limits/current.json
workflows/target_acquisition/*_worked*.ipynb
# What `run_webapp.py --demo` writes: images, reports and the run journal of a
# simulated run. Regenerated on every demo, never part of the repository.
workflows/target_acquisition/zmart_demo_run/

# Nikon bridge: the stop flag the macros exchange, and probe outputs.
zmart_drivers/nikon/nis_elements_6_10/bridge/bridge.stop
# The start/stop macros carry this computer's repository path; bridge/install.py writes them.
zmart_drivers/nikon/nis_elements_6_10/bridge/*.mac
zmart_drivers/nikon/spike/*.report.txt
zmart_drivers/nikon/spike/*_heartbeat.txt

# nis_useq bridge: the machine-specific macros and the stop flag they exchange.
zmart_drivers/nikon/nis_useq/nis_useq/*.mac
zmart_drivers/nikon/nis_useq/nis_useq/bridge.stop
